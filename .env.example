# Auth goes through pi (ModelRuntime): ~/.pi/agent/auth.json or env.
# OPENROUTER_API_KEY is read by pi's OpenRouter provider — this app does not HTTP OpenRouter.
OPENROUTER_API_KEY=

# pi (default) | mock
GM_MODE=pi

# provider/id:thinking — resolved by pi resolveCliModel
PI_MODEL=openrouter/deepseek/deepseek-v4-flash:off
